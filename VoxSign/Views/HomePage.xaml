<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:v="clr-namespace:Voxsign" xmlns:c="clr-namespace:Voxsign.Controls" x:Class="Voxsign.Views.HomePage">
  <ScrollView><VerticalStackLayout Padding="20,16" Spacing="14">

    <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Bonjour Daniela 👋" Style="{StaticResource H2}" FontSize="28"/><Label Text="VoxSign · à votre rythme" Style="{StaticResource Muted}"/></VerticalStackLayout><Label Grid.Column="1" Text="👤 Profil" Style="{StaticResource Muted}"/></Grid>
    <Border Style="{StaticResource Photo}" HeightRequest="230"><Image Source="hero.jpg" Aspect="AspectFill"/></Border>
    <Grid ColumnDefinitions="*,Auto"><Label Text="Chaque échange compte." Style="{StaticResource H2}"/><Border Style="{StaticResource SoftCard}" Padding="12,4" Grid.Column="1"><Label Text="✋ LSF" Style="{StaticResource Link}"/></Border></Grid>
    <Label Text="Comment communiquer ?" Style="{StaticResource H2}" FontSize="20"/>
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
      <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource Primary}" HeightRequest="140" Padding="18"><VerticalStackLayout Spacing="4" VerticalOptions="End"><Label Text="Texte → signes" TextColor="White" FontSize="19" FontAttributes="Bold"/><Label Text="Écrire, illustrer et faire lire" TextColor="White" FontSize="14"/></VerticalStackLayout><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Go, Source={x:Static v:Nav.I}}" CommandParameter="texte"/></Border.GestureRecognizers></Border>
      <Grid Grid.Column="1"><Border Style="{StaticResource Card}" BackgroundColor="White" HeightRequest="140" Padding="18"><VerticalStackLayout Spacing="4" VerticalOptions="End"><Label Text="Voix → texte" TextColor="{StaticResource Ink}" FontSize="19" FontAttributes="Bold"/><Label Text="Lire ce que l’on vous dit" TextColor="{StaticResource Muted}" FontSize="14"/></VerticalStackLayout><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Go, Source={x:Static v:Nav.I}}" CommandParameter="voix"/></Border.GestureRecognizers></Border></Grid>
      <Grid Grid.Row="1"><Border Style="{StaticResource Card}" BackgroundColor="White" HeightRequest="140" Padding="18"><VerticalStackLayout Spacing="4" VerticalOptions="End"><Label Text="Phrases utiles" TextColor="{StaticResource Ink}" FontSize="19" FontAttributes="Bold"/><Label Text="Des mots pour le quotidien" TextColor="{StaticResource Muted}" FontSize="14"/></VerticalStackLayout><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Go, Source={x:Static v:Nav.I}}" CommandParameter="phrases"/></Border.GestureRecognizers></Border></Grid>
      <Grid Grid.Row="1" Grid.Column="1"><Border Style="{StaticResource Card}" BackgroundColor="White" HeightRequest="140" Padding="18"><VerticalStackLayout Spacing="4" VerticalOptions="End"><Label Text="Échanger" TextColor="{StaticResource Ink}" FontSize="19" FontAttributes="Bold"/><Label Text="Un espace avec vos proches" TextColor="{StaticResource Muted}" FontSize="14"/></VerticalStackLayout><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Go, Source={x:Static v:Nav.I}}" CommandParameter="//main/echanges"/></Border.GestureRecognizers></Border></Grid>
    </Grid>
    <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Vos essentiels, même sans réseau"/><Label Text="2 packs téléchargés · Gérer les packs" Style="{StaticResource Link}"/></VerticalStackLayout><Label Grid.Column="1" Text="›" Style="{StaticResource Link}" FontSize="22"/></Grid><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Go, Source={x:Static v:Nav.I}}" CommandParameter="offline"/></Border.GestureRecognizers></Border>
    <c:Disclaimer/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
