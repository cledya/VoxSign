<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:v="clr-namespace:Voxsign" xmlns:c="clr-namespace:Voxsign.Controls;assembly=VoxSign" x:Class="Voxsign.Views.HorsConnexionPage">
  <ScrollView><VerticalStackLayout Padding="20,16" Spacing="14">

    <c:Header Title="Sans connexion" Subtitle="Préparer vos essentiels à l’avance"/>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="10"><Label Text="☁ 2 packs prêts à vous accompagner" FontSize="19"/><Label Text="48 signes · 20 phrases · 40 Mo utilisés" Style="{StaticResource Muted}"/><ProgressBar Progress="0.33" ProgressColor="{StaticResource Primary}"/></VerticalStackLayout></Border>
    <Label Text="Vos packs téléchargés" Style="{StaticResource H2}" FontSize="20"/>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Style="{StaticResource Card}" Padding="12"><Label Text="🤝" FontSize="22"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Les essentiels" FontSize="20"/><Label Text="30 signes · 12 phrases" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><Grid ColumnDefinitions="Auto,*"><Border Style="{StaticResource SoftCard}" Padding="12,6"><Label Text="✓ Téléchargé · 24 Mo" Style="{StaticResource Link}"/></Border><Label Grid.Column="1" Text="Gérer" Style="{StaticResource Link}" FontSize="16" HorizontalOptions="End"/></Grid></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Style="{StaticResource Card}" Padding="12"><Label Text="☕" FontSize="22"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Au quotidien" FontSize="20"/><Label Text="18 signes · 8 phrases" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><Grid ColumnDefinitions="Auto,*"><Border Style="{StaticResource SoftCard}" Padding="12,6"><Label Text="✓ Téléchargé · 16 Mo" Style="{StaticResource Link}"/></Border><Label Grid.Column="1" Text="Gérer" Style="{StaticResource Link}" FontSize="16" HorizontalOptions="End"/></Grid></VerticalStackLayout></Border>
    <Grid ColumnDefinitions="*,Auto"><Label Text="À ajouter" Style="{StaticResource H2}" FontSize="20"/><Label Grid.Column="1" Text="Via Wi-Fi" Style="{StaticResource Link}"/></Grid>
    <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Style="{StaticResource Card}" Padding="12"><Label Text="💗" FontSize="22"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Santé &amp; besoins" FontSize="20"/><Label Text="24 signes · 12 phrases" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><Grid ColumnDefinitions="Auto,*"><Border Style="{StaticResource SoftCard}" Padding="12,6"><Label Text="⬇ 18 Mo" Style="{StaticResource Link}"/></Border><Label Grid.Column="1" Text="Télécharger" Style="{StaticResource Link}" FontSize="16" HorizontalOptions="End"/></Grid></VerticalStackLayout></Border>
    <Border Style="{StaticResource Card}"><Label Text="ⓘ Hors connexion : consultez vos packs, écrivez et montrez une phrase. La reconnaissance vocale et les échanges nécessitent Internet." Style="{StaticResource Muted}"/></Border>
    <Label Text="Lecture vocale hors ligne : selon les voix déjà installées sur votre téléphone. Les favoris restent consultables." Style="{StaticResource Muted}"/>
  </VerticalStackLayout></ScrollView>
</ContentPage>
